# Porta do Javalin (o compose publica só em 127.0.0.1:8081)
SERVER_PORT=8081

# Banco do Blockchain Service (o compose usa DB_USER e DB_PASSWORD para criar o usuário no MySQL)
DB_URL=jdbc:mysql://blockchain-db:3306/blockchain
DB_USER=app
DB_PASSWORD=change-me

# Provedor RPC da Sepolia (P8). Nunca use mainnet: o serviço recusa CHAIN_ID diferente de 11155111.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# Valor esperado no cabeçalho X-Service-Key (P2). Combine o mesmo valor com o Core API.
SERVICE_KEY=change-me

# Chave AES-256 em Base64 (32 bytes). O valor abaixo é proposital e inválido:
# o serviço não sobe até você gerar uma chave com: openssl rand -base64 32
WALLET_ENCRYPTION_KEY=GERAR_COM_openssl_rand_-base64_32

# Destino do webhook CT15 no Core API
CORE_API_WEBHOOK_URL=http://core-api:8080/webhooks/tasks

# Intervalo do worker e timeout das chamadas ao RPC, em segundos
WORKER_INTERVAL_SECONDS=5
RPC_TIMEOUT_SECONDS=10
